#!/usr/bin/env bash
set -euo pipefail

exec python3 - "$@" 3<&0 <<'PY'
import argparse
from contextlib import contextmanager
import datetime as dt
import fcntl
import hashlib
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import tempfile


PARSER_VERSION = "1"
PROVIDER_NAMES = {"claude": "Claude", "codex": "Codex"}


def sha256(data):
    return hashlib.sha256(data).hexdigest()


def load_registry(path):
    try:
        registry = json.loads(path.read_text(encoding="utf-8"))
    except FileNotFoundError:
        raise ValueError(f"account registry does not exist: {path}")
    except json.JSONDecodeError as error:
        backup = backup_invalid_registry(path)
        raise ValueError(f"account registry is invalid JSON: {path}: {error}; backup: {backup}")
    problem = registry_schema_problem(registry)
    if problem:
        backup = backup_invalid_registry(path)
        raise ValueError(f"unsupported account registry: {path}: {problem}; backup: {backup}")
    return registry


def registry_schema_problem(registry):
    if not isinstance(registry, dict):
        return "root must be an object"
    if type(registry.get("version")) is not int or registry["version"] != 1:
        return "version must be 1"
    next_number = registry.get("next_number")
    if not isinstance(next_number, dict) or set(next_number) != set(PROVIDER_NAMES):
        return "next_number must contain claude and codex"
    for provider in PROVIDER_NAMES:
        value = next_number[provider]
        if type(value) is not int or value < 1:
            return f"next_number.{provider} must be a positive integer"
    accounts = registry.get("accounts")
    if not isinstance(accounts, list):
        return "accounts must be an array"

    account_ids = set()
    provider_numbers = set()
    account_homes = set()
    highest_number = {provider: 0 for provider in PROVIDER_NAMES}
    required_fields = {"id", "provider", "number", "home", "alias"}
    for index, account in enumerate(accounts):
        prefix = f"accounts[{index}]"
        if not isinstance(account, dict) or not required_fields.issubset(account):
            return f"{prefix} is missing required fields"
        provider = account["provider"]
        number = account["number"]
        if provider not in PROVIDER_NAMES:
            return f"{prefix}.provider is unsupported"
        if type(number) is not int or number < 1:
            return f"{prefix}.number must be a positive integer"
        if account["id"] != f"{provider}-{number}":
            return f"{prefix}.id does not match provider and number"
        if not isinstance(account["home"], str) or not account["home"]:
            return f"{prefix}.home must be a non-empty string"
        if not isinstance(account["alias"], str):
            return f"{prefix}.alias must be a string"
        try:
            resolved_home = str(Path(account["home"]).expanduser().resolve())
        except (OSError, ValueError):
            return f"{prefix}.home is invalid"
        if account["id"] in account_ids:
            return f"duplicate account id: {account['id']}"
        if (provider, number) in provider_numbers:
            return f"duplicate provider account number: {provider}-{number}"
        if resolved_home in account_homes:
            return f"duplicate account home: {resolved_home}"
        account_ids.add(account["id"])
        provider_numbers.add((provider, number))
        account_homes.add(resolved_home)
        highest_number[provider] = max(highest_number[provider], number)

    for provider, highest in highest_number.items():
        if next_number[provider] <= highest:
            return f"next_number.{provider} must be greater than every registered number"
    return ""


def backup_invalid_registry(path):
    stamp = dt.datetime.now(dt.timezone.utc).strftime("%Y%m%dT%H%M%S%fZ")
    backup = path.with_name(f"{path.name}.corrupt-{stamp}")
    shutil.copy2(path, backup)
    return backup


def empty_registry():
    return {"version": 1, "next_number": {"claude": 1, "codex": 1}, "accounts": []}


def load_registry_or_empty(path):
    return load_registry(path) if path.exists() else empty_registry()


@contextmanager
def registry_lock(path):
    path.parent.mkdir(parents=True, exist_ok=True)
    lock_path = path.with_name(f"{path.name}.lock")
    with lock_path.open("a+", encoding="utf-8") as lock_file:
        lock_path.chmod(0o600)
        fcntl.flock(lock_file, fcntl.LOCK_EX)
        try:
            yield
        finally:
            fcntl.flock(lock_file, fcntl.LOCK_UN)


def save_registry(path, registry):
    problem = registry_schema_problem(registry)
    if problem:
        raise ValueError(f"refusing to write invalid account registry: {problem}")
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, temporary_name = tempfile.mkstemp(prefix=f".{path.name}.", suffix=".tmp", dir=path.parent)
    temporary = Path(temporary_name)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            json.dump(registry, handle, indent=2, sort_keys=True)
            handle.write("\n")
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporary, path)
    except Exception:
        temporary.unlink(missing_ok=True)
        raise


def register_account(registry, provider, account_home, alias="", create_home=True):
    resolved_home = account_home.expanduser().resolve()
    if any(Path(item["home"]).expanduser().resolve() == resolved_home for item in registry["accounts"]):
        raise ValueError(f"account home is already registered: {resolved_home}")
    number = registry["next_number"][provider]
    account = {"id": f"{provider}-{number}", "provider": provider, "number": number, "home": str(resolved_home), "alias": alias}
    if create_home:
        resolved_home.mkdir(parents=True, exist_ok=True)
    registry["accounts"].append(account)
    registry["next_number"][provider] = number + 1
    return account


def add_account(registry_path, provider, account_home, alias=""):
    with registry_lock(registry_path):
        registry = load_registry_or_empty(registry_path)
        account = register_account(registry, provider, account_home, alias)
        save_registry(registry_path, registry)
    return account


def remove_account(registry_path, account_id):
    with registry_lock(registry_path):
        registry = load_registry(registry_path)
        remaining = [item for item in registry["accounts"] if item["id"] != account_id]
        if len(remaining) == len(registry["accounts"]):
            raise ValueError(f"account is not registered: {account_id}")
        registry["accounts"] = remaining
        save_registry(registry_path, registry)


def find_account(registry, account_id):
    for account in registry["accounts"]:
        if account["id"] == account_id:
            return account
    raise ValueError(f"account is not registered: {account_id}")


def rename_account(registry_path, account_id, alias):
    with registry_lock(registry_path):
        registry = load_registry(registry_path)
        find_account(registry, account_id)["alias"] = alias
        save_registry(registry_path, registry)


def account_auth_status(account):
    provider = account["provider"]
    command = "claude" if provider == "claude" else "codex"
    if not shutil.which(command):
        raise ValueError(f"provider CLI is not installed: {command}")
    environment = dict(os.environ)
    account_home = str(Path(account["home"]).expanduser().resolve())
    if provider == "claude":
        default_home = str((Path(os.environ.get("HOME", str(Path.home()))) / ".claude").resolve())
        if account_home == default_home:
            environment.pop("CLAUDE_CONFIG_DIR", None)
        else:
            environment["CLAUDE_CONFIG_DIR"] = account_home
        arguments = ["claude", "auth", "status"]
    else:
        environment["CODEX_HOME"] = account_home
        arguments = ["codex", "login", "status"]
    try:
        result = subprocess.run(arguments, env=environment, text=True, capture_output=True, timeout=15)
    except subprocess.TimeoutExpired:
        return False
    return result.returncode == 0


def discover_accounts(registry_path):
    user_home = Path(os.environ.get("HOME", str(Path.home()))).expanduser().resolve()
    registered = set()
    if registry_path.exists():
        registered = {str(Path(item["home"]).expanduser().resolve()) for item in load_registry(registry_path)["accounts"]}
    candidates = []
    for provider, default_name in (("claude", ".claude"), ("codex", ".codex")):
        default_home = user_home / default_name
        if default_home.is_dir():
            candidates.append((provider, default_home))
        pattern = re.compile(rf"^{re.escape(default_name)}-[0-9]+$")
        candidates.extend((provider, path) for path in sorted(user_home.glob(f"{default_name}-*")) if path.is_dir() and pattern.match(path.name))
    legacy_root = user_home / ".codex-homes"
    if legacy_root.is_dir():
        candidates.extend(("codex", path) for path in sorted(legacy_root.iterdir()) if path.is_dir())
    return [(provider, path) for provider, path in candidates if str(path.resolve()) not in registered]


def suggest_account_home(registry_path, provider):
    registry = load_registry_or_empty(registry_path)
    user_home = Path(os.environ.get("HOME", str(Path.home()))).expanduser().resolve()
    registered_homes = {str(Path(item["home"]).expanduser().resolve()) for item in registry["accounts"]}
    suffix = 1
    while True:
        name = f".{provider}" if suffix == 1 else f".{provider}-{suffix}"
        candidate = user_home / name
        if not os.path.lexists(candidate) and str(candidate.resolve()) not in registered_homes:
            return candidate
        suffix += 1


def account_rows(registry):
    counts = {}
    for account in registry["accounts"]:
        provider = account.get("provider")
        counts[provider] = counts.get(provider, 0) + 1
    rows = []
    for account in sorted(registry["accounts"], key=lambda item: (item["provider"], item["number"])):
        name = PROVIDER_NAMES[account["provider"]]
        if counts[account["provider"]] > 1:
            name += f" · {account['number']}"
            if account.get("alias"):
                name += f" · {account['alias']}"
        rows.append((account["id"], name))
    return rows


def text_content(content):
    if isinstance(content, str):
        return content
    if not isinstance(content, list):
        return ""
    parts = []
    for item in content:
        if not isinstance(item, dict):
            continue
        if isinstance(item.get("text"), str):
            parts.append(item["text"])
        elif isinstance(item.get("content"), str):
            parts.append(item["content"])
    return "\n".join(parts)


def render_transcript(raw, source_type):
    sections = [f"# {PROVIDER_NAMES[source_type]} Conversation Transcript", "", "The complete source record is `source.jsonl` in this directory.", ""]
    for line_number, line in enumerate(raw.decode("utf-8", errors="replace").splitlines(), start=1):
        try:
            entry = json.loads(line)
        except json.JSONDecodeError:
            continue
        if source_type == "codex":
            if entry.get("type") != "response_item":
                continue
            payload = entry.get("payload", {})
            if not isinstance(payload, dict):
                continue
            kind = payload.get("role")
            content = payload.get("content", "")
        else:
            kind = entry.get("type")
            message = entry.get("message", {})
            content = message.get("content", entry.get("content", "")) if isinstance(message, dict) else ""
        if kind not in {"user", "assistant"}:
            continue
        text = text_content(content)
        if not text.strip():
            continue
        title = "User" if kind == "user" else "Assistant"
        sections.extend([f"## {title} (source line {line_number})", "", text, ""])
    return "\n".join(sections)


def create(source_path, target_path, source_type="claude"):
    source = source_path.resolve()
    target = target_path.resolve()
    if not source.is_file():
        raise ValueError(f"source is not a file: {source}")

    raw = source.read_bytes()
    source_hash = sha256(raw)
    artifact_root = target / ".agent-handoffs"
    artifact_root.mkdir(parents=True, exist_ok=True, mode=0o700)
    artifact_root.chmod(0o700)
    ignore_file = artifact_root / ".gitignore"
    if not ignore_file.exists():
        ignore_file.write_text("*\n", encoding="utf-8")
    ignore_file.chmod(0o600)
    stamp = dt.datetime.now(dt.timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    artifact_name = f"{stamp}-{source_hash[:12]}"
    destination = artifact_root / artifact_name
    if destination.exists():
        raise ValueError(f"artifact already exists: {destination}")

    temporary = Path(tempfile.mkdtemp(prefix=".creating-", dir=artifact_root))
    try:
        snapshot = temporary / "source.jsonl"
        snapshot.write_bytes(raw)
        snapshot.chmod(0o600)
        transcript = temporary / "transcript.md"
        transcript.write_text(render_transcript(raw, source_type), encoding="utf-8")
        transcript.chmod(0o600)
        manifest = {
            "artifact_version": 1,
            "parser_version": PARSER_VERSION,
            "created_at": dt.datetime.now(dt.timezone.utc).isoformat(),
            "source": {"path": str(source), "type": source_type, "bytes": len(raw), "sha256": source_hash},
            "files": {
                "source.jsonl": sha256(snapshot.read_bytes()),
                "transcript.md": sha256(transcript.read_bytes()),
            },
        }
        manifest_path = temporary / "manifest.json"
        manifest_path.write_text(json.dumps(manifest, indent=2, sort_keys=True) + "\n", encoding="utf-8")
        manifest_path.chmod(0o600)
        if sha256(source.read_bytes()) != source_hash:
            raise RuntimeError("source changed while creating handoff; no artifact was published")
        os.replace(temporary, destination)
    except Exception:
        shutil.rmtree(temporary, ignore_errors=True)
        raise

    print(destination)
    return destination


def session_text(entry):
    message = entry.get("message", {})
    content = message.get("content", entry.get("content", "")) if isinstance(message, dict) else ""
    return text_content(content).replace("\n", " ").strip()


def session_candidates(source_config, project):
    project_id = str(project.resolve()).replace("/", "-")
    session_dir = source_config / "projects" / project_id
    if not session_dir.is_dir():
        raise ValueError(f"no Claude sessions for this project: {session_dir}")
    candidates = []
    for path in sorted(session_dir.glob("*.jsonl"), key=lambda item: item.stat().st_mtime, reverse=True):
        session_id = "unknown UUID"
        preview = ""
        try:
            for line in path.read_text(encoding="utf-8", errors="replace").splitlines():
                entry = json.loads(line)
                session_id = entry.get("sessionId") or entry.get("session_id") or session_id
                if entry.get("type") == "user" and not preview:
                    preview = session_text(entry)
                if session_id != "unknown UUID" and preview:
                    break
        except (OSError, json.JSONDecodeError):
            continue
        timestamp = dt.datetime.fromtimestamp(path.stat().st_mtime).strftime("%Y-%m-%d %H:%M")
        candidates.append((path, f"{timestamp}  {session_id}  {preview[:70]}"))
    if not candidates:
        raise ValueError(f"no readable Claude sessions for this project: {session_dir}")
    return candidates


def codex_session_candidates(codex_home, project):
    sessions = codex_home / "sessions"
    if not sessions.is_dir():
        raise ValueError(f"no Codex sessions directory: {sessions}")
    candidates = []
    for path in sessions.rglob("*.jsonl"):
        session_id = "unknown UUID"
        session_cwd = ""
        preview = ""
        try:
            for line in path.read_text(encoding="utf-8", errors="replace").splitlines():
                entry = json.loads(line)
                payload = entry.get("payload", {})
                if entry.get("type") == "session_meta" and isinstance(payload, dict):
                    session_id = payload.get("id", session_id)
                    session_cwd = payload.get("cwd", session_cwd)
                if entry.get("type") == "response_item" and isinstance(payload, dict) and payload.get("role") == "user" and not preview:
                    preview = text_content(payload.get("content", "")).replace("\n", " ").strip()
        except (OSError, json.JSONDecodeError):
            continue
        if not session_cwd or Path(session_cwd).resolve() != project.resolve():
            continue
        timestamp = dt.datetime.fromtimestamp(path.stat().st_mtime).strftime("%Y-%m-%d %H:%M")
        candidates.append((path, f"{timestamp}  {session_id}  {preview[:70]}"))
    if not candidates:
        raise ValueError(f"no readable Codex sessions for this project: {sessions}")
    return sorted(candidates, key=lambda item: item[0].stat().st_mtime, reverse=True)


def pick_session(candidates, prompt="Select conversation: "):
    if not shutil.which("fzf"):
        raise ValueError("fzf is required to select a conversation")
    rows = "\n".join(f"{path}\t{description}" for path, description in candidates) + "\n"
    result = subprocess.run(
        ["fzf", "--height=~15", "--border=none", "--with-nth=2..", "--delimiter=\t", f"--prompt={prompt}"],
        input=rows,
        text=True,
        capture_output=True,
    )
    if result.returncode != 0:
        raise ValueError("conversation selection cancelled")
    selected = result.stdout.strip().split("\t", 1)[0]
    if not selected:
        raise ValueError("no conversation selected")
    return Path(selected)


def pick_key(candidates, prompt):
    if not shutil.which("fzf"):
        raise ValueError("fzf is required")
    rows = "\n".join(f"{key}\t{description}" for key, description in candidates) + "\n"
    result = subprocess.run(
        ["fzf", "--height=~15", "--border=none", "--with-nth=2..", "--delimiter=\t", f"--prompt={prompt}"],
        input=rows,
        text=True,
        capture_output=True,
    )
    if result.returncode != 0:
        raise ValueError("selection cancelled")
    selected = result.stdout.strip().split("\t", 1)[0]
    if not selected:
        raise ValueError("nothing selected")
    return selected


def launch_account(account, artifact):
    prompt = (
        f"Read {artifact / 'transcript.md'} first. Use {artifact / 'source.jsonl'} "
        "for complete history, then continue the user's work in this project."
    )
    environment = dict(os.environ)
    account_home = str(Path(account["home"]).expanduser().resolve())
    if account["provider"] == "claude":
        default_home = str((Path(os.environ.get("HOME", str(Path.home()))) / ".claude").resolve())
        if account_home == default_home:
            environment.pop("CLAUDE_CONFIG_DIR", None)
        else:
            environment["CLAUDE_CONFIG_DIR"] = account_home
        os.execvpe("claude", ["claude", prompt], environment)
    environment["CODEX_HOME"] = account_home
    os.execvpe("codex", ["codex", prompt], environment)


def registry_handoff(registry_path, source_id, target_id, session, project, launch):
    registry = load_registry(registry_path)
    source = find_account(registry, source_id)
    target = find_account(registry, target_id)
    if source_id == target_id:
        raise ValueError("source and target accounts must be different")
    if not account_auth_status(target):
        raise ValueError(f"target account is not authenticated: {target_id}")
    artifact = create(session, project, source["provider"])
    if launch:
        launch_account(target, artifact)
    return 0


def launch_account_session(account):
    environment = dict(os.environ)
    account_home = str(Path(account["home"]).expanduser().resolve())
    if account["provider"] == "claude":
        default_home = str((Path(os.environ.get("HOME", str(Path.home()))) / ".claude").resolve())
        if account_home == default_home:
            environment.pop("CLAUDE_CONFIG_DIR", None)
        else:
            environment["CLAUDE_CONFIG_DIR"] = account_home
        os.execvpe("claude", ["claude"], environment)
    environment["CODEX_HOME"] = account_home
    os.execvpe("codex", ["codex"], environment)


def sessions_for_account(account, project):
    account_home = Path(account["home"])
    if account["provider"] == "claude":
        return session_candidates(account_home, project)
    return codex_session_candidates(account_home, project)


def interactive_registry_handoff(registry_path, project):
    registry = load_registry(registry_path)
    labels = dict(account_rows(registry))
    available_sources = []
    sessions_by_account = {}
    for account in registry["accounts"]:
        try:
            sessions = sessions_for_account(account, project)
        except ValueError:
            continue
        sessions_by_account[account["id"]] = sessions
        available_sources.append((account["id"], labels[account["id"]]))
    if not available_sources:
        raise ValueError("no registered account has conversations for this project")
    source_id = pick_key(available_sources, "選擇來源帳號: ")
    session = pick_session(sessions_by_account[source_id], "選擇來源對話: ")
    targets = []
    for account in registry["accounts"]:
        if account["id"] == source_id:
            continue
        command = "claude" if account["provider"] == "claude" else "codex"
        if shutil.which(command):
            targets.append((account["id"], labels[account["id"]]))
    if not targets:
        raise ValueError("no different target account is available")
    target_id = pick_key(targets, "選擇目標帳號: ")
    return registry_handoff(registry_path, source_id, target_id, session, project, True)


def bootstrap_registry(registry_path):
    candidates = discover_accounts(registry_path)
    registry = empty_registry()
    for provider, account_home in candidates:
        provider_name = PROVIDER_NAMES[provider]
        choice = pick_key(
            [("import", f"匯入 {provider_name}: {account_home}"), ("skip", "略過這個目錄")],
            "偵測到既有帳號目錄: ",
        )
        if choice == "import":
            alias = read_optional_alias(f"{provider_name} alias（選填）: ")
            register_account(registry, provider, account_home, alias, create_home=False)
    with registry_lock(registry_path):
        if not registry_path.exists():
            save_registry(registry_path, registry)


def choose_registered_account(registry, prompt):
    labels = dict(account_rows(registry))
    return pick_key([(item["id"], labels[item["id"]]) for item in registry["accounts"]], prompt)


def read_optional_alias(prompt="alias（選填）: "):
    print(prompt, end="", flush=True)
    try:
        with os.fdopen(os.dup(3), "r", encoding="utf-8") as user_input:
            return user_input.readline().strip()
    except OSError:
        return ""


def login_account(account):
    environment = dict(os.environ)
    account_home = str(Path(account["home"]).expanduser().resolve())
    if account["provider"] == "claude":
        default_home = str((Path(os.environ.get("HOME", str(Path.home()))) / ".claude").resolve())
        if account_home == default_home:
            environment.pop("CLAUDE_CONFIG_DIR", None)
        else:
            environment["CLAUDE_CONFIG_DIR"] = account_home
        os.execvpe("claude", ["claude", "auth", "login"], environment)
    environment["CODEX_HOME"] = account_home
    os.execvpe("codex", ["codex", "login"], environment)


def manage_accounts(registry_path):
    while True:
        action = pick_key(
            [
                ("add", "新增帳號"),
                ("rename", "修改 alias"),
                ("login", "登入／重新登入"),
                ("remove", "從 ccs 移除帳號"),
                ("import", "匯入既有帳號目錄"),
                ("back", "返回主選單"),
            ],
            "帳號設定: ",
        )
        if action == "back":
            return
        if action == "add":
            providers = []
            for provider, command in (("claude", "claude"), ("codex", "codex")):
                if shutil.which(command):
                    providers.append((provider, PROVIDER_NAMES[provider]))
            if not providers:
                raise ValueError("no provider CLI is installed")
            provider = pick_key(providers, "選擇 provider: ")
            account_home = suggest_account_home(registry_path, provider)
            confirmation = pick_key(
                [("confirm", f"建立帳號目錄: {account_home}"), ("cancel", "取消")],
                "確認新增帳號: ",
            )
            if confirmation == "confirm":
                alias = read_optional_alias()
                account = add_account(registry_path, provider, account_home, alias)
                login_account(account)
            continue
        if action == "rename":
            registry = load_registry(registry_path)
            account_id = choose_registered_account(registry, "選擇要修改 alias 的帳號: ")
            alias = read_optional_alias("新的 alias（留空即清除）: ")
            rename_account(registry_path, account_id, alias)
            continue
        if action == "login":
            registry = load_registry(registry_path)
            account_id = choose_registered_account(registry, "選擇要登入的帳號: ")
            login_account(find_account(registry, account_id))
        if action == "import":
            candidates = discover_accounts(registry_path)
            if not candidates:
                print("沒有可匯入的既有帳號目錄。")
                continue
            selected = pick_key(
                [(f"{provider}|{account_home}", f"{PROVIDER_NAMES[provider]}: {account_home}") for provider, account_home in candidates],
                "選擇要匯入的帳號目錄: ",
            )
            provider, account_home = selected.split("|", 1)
            alias = read_optional_alias()
            add_account(registry_path, provider, Path(account_home), alias)
            continue
        if action == "remove":
            registry = load_registry(registry_path)
            account_id = choose_registered_account(registry, "選擇要取消登記的帳號: ")
            confirmation = pick_key(
                [("confirm", "只從 ccs 移除，保留所有帳號資料"), ("cancel", "取消")],
                "確認取消登記: ",
            )
            if confirmation == "confirm":
                remove_account(registry_path, account_id)
            continue
        raise ValueError(f"account action is not implemented yet: {action}")


def menu(registry_path):
    if not registry_path.exists():
        bootstrap_registry(registry_path)
    while True:
        registry = load_registry(registry_path)
        labels = dict(account_rows(registry))
        candidates = []
        for account in registry["accounts"]:
            command = "claude" if account["provider"] == "claude" else "codex"
            if shutil.which(command):
                candidates.append((account["id"], labels[account["id"]]))
        candidates.extend((("action:handoff", "接手既有對話"), ("action:accounts", "帳號設定")))
        selected = pick_key(candidates, "選擇帳號或功能: ")
        if selected == "action:handoff":
            return interactive_registry_handoff(registry_path, Path.cwd())
        if selected == "action:accounts":
            manage_accounts(registry_path)
            continue
        launch_account_session(find_account(registry, selected))


def main():
    parser = argparse.ArgumentParser(prog="ach", description="Manage provider accounts and immutable conversation handoffs.")
    subcommands = parser.add_subparsers(dest="command", required=True)
    create_parser = subcommands.add_parser("create", help="snapshot a source JSONL into a target project")
    create_parser.add_argument("--source", type=Path, required=True)
    create_parser.add_argument("--target", type=Path, required=True)
    create_parser.add_argument("--source-type", choices=("claude", "codex"), default="claude")
    default_registry = Path(os.environ.get("ACH_CONFIG_DIR", Path.home() / ".config" / "agent-conversation-handoff")) / "accounts.json"
    handoff_parser = subcommands.add_parser("handoff", help="select a current-project session and open a new-account handoff")
    handoff_parser.add_argument("--registry", type=Path, default=default_registry)
    handoff_parser.add_argument("--source-id")
    handoff_parser.add_argument("--target-id")
    handoff_parser.add_argument("--session", type=Path)
    handoff_parser.add_argument("--no-launch", action="store_true", help="create the artifact without opening Claude account 2")
    accounts_parser = subcommands.add_parser("accounts", help="manage the account registry")
    account_commands = accounts_parser.add_subparsers(dest="accounts_command", required=True)
    accounts_list = account_commands.add_parser("list")
    accounts_list.add_argument("--registry", type=Path, required=True)
    accounts_add = account_commands.add_parser("add")
    accounts_add.add_argument("--registry", type=Path, required=True)
    accounts_add.add_argument("--provider", choices=("claude", "codex"), required=True)
    accounts_add.add_argument("--home", type=Path, required=True)
    accounts_add.add_argument("--alias", default="")
    accounts_remove = account_commands.add_parser("remove")
    accounts_remove.add_argument("--registry", type=Path, required=True)
    accounts_remove.add_argument("--id", required=True)
    accounts_rename = account_commands.add_parser("rename")
    accounts_rename.add_argument("--registry", type=Path, required=True)
    accounts_rename.add_argument("--id", required=True)
    accounts_rename.add_argument("--alias", default="")
    accounts_auth = account_commands.add_parser("auth-status")
    accounts_auth.add_argument("--registry", type=Path, required=True)
    accounts_auth.add_argument("--id", required=True)
    accounts_discover = account_commands.add_parser("discover")
    accounts_discover.add_argument("--registry", type=Path, required=True)
    accounts_suggest = account_commands.add_parser("suggest-home")
    accounts_suggest.add_argument("--registry", type=Path, required=True)
    accounts_suggest.add_argument("--provider", choices=("claude", "codex"), required=True)
    menu_parser = subcommands.add_parser("menu", help="open the account and handoff menu")
    menu_parser.add_argument("--registry", type=Path, required=True)
    args = parser.parse_args()
    try:
        if args.command == "create":
            create(args.source, args.target, args.source_type)
            return 0
        if args.command == "menu":
            menu(args.registry)
            return 0
        if args.command == "accounts" and args.accounts_command == "list":
            for account_id, label in account_rows(load_registry(args.registry)):
                print(f"{account_id}\t{label}")
            return 0
        if args.command == "accounts" and args.accounts_command == "add":
            account = add_account(args.registry, args.provider, args.home, args.alias)
            print(account["id"])
            return 0
        if args.command == "accounts" and args.accounts_command == "remove":
            remove_account(args.registry, args.id)
            return 0
        if args.command == "accounts" and args.accounts_command == "rename":
            rename_account(args.registry, args.id, args.alias)
            return 0
        if args.command == "accounts" and args.accounts_command == "auth-status":
            authenticated = account_auth_status(find_account(load_registry(args.registry), args.id))
            print("authenticated" if authenticated else "not-authenticated")
            return 0 if authenticated else 1
        if args.command == "accounts" and args.accounts_command == "discover":
            for provider, account_home in discover_accounts(args.registry):
                print(f"{provider}\t{account_home}")
            return 0
        if args.command == "accounts" and args.accounts_command == "suggest-home":
            print(suggest_account_home(args.registry, args.provider))
            return 0
        if args.command == "handoff":
            selected = (args.source_id, args.target_id, args.session)
            if any(selected) and not all(selected):
                raise ValueError("explicit handoff requires source, target, and session together")
            if all(selected):
                return registry_handoff(args.registry, args.source_id, args.target_id, args.session, Path.cwd(), not args.no_launch)
            return interactive_registry_handoff(args.registry, Path.cwd())
    except (OSError, ValueError, RuntimeError) as error:
        print(f"ach: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
PY
