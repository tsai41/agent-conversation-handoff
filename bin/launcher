#!/usr/bin/env bash
set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  LINK_DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" = /* ]] || SOURCE="$LINK_DIR/$SOURCE"
done
BIN_DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
CONFIG_DIR="${ACH_CONFIG_DIR:-$HOME/.config/agent-conversation-handoff}"

exec "$BIN_DIR/ach" menu --registry "$CONFIG_DIR/accounts.json"
